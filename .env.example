APP_NAME="kynex OmniChannel AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com
APP_VERSION=
GIT_COMMIT_SHA=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kynex_omnichannel_ai
DB_USERNAME=change_me
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database
QUEUE_WEBHOOK_CONNECTION=${QUEUE_CONNECTION}
QUEUE_WEBHOOK_NAME=webhooks
QUEUE_INTEGRATIONS_CONNECTION=${QUEUE_CONNECTION}
QUEUE_INTEGRATIONS_NAME=integrations
QUEUE_REMINDERS_CONNECTION=${QUEUE_CONNECTION}
QUEUE_REMINDERS_NAME=reminders
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_WORKER_HEARTBEAT_TTL=300

CACHE_STORE=database
CACHE_PREFIX=kynex-omnichannel-ai

DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me
MESSENGER_VERIFY_TOKEN=replace_me
MESSENGER_APP_SECRET=replace_me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/settings/integrations/google/callback"

FEATURE_USAGE_ENFORCEMENT=true
USAGE_WARNING_THRESHOLD=0.8

FEATURE_VOICE_AGENT=false
VOICE_TRANSPORT=null
VOICE_STT_PROVIDER=null
VOICE_LLM_PROVIDER=null
VOICE_TTS_PROVIDER=null
VOICE_LLM_MODEL=openai/gpt-4.1-mini

TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
VOICE_SIP_SERVER=
VOICE_SIP_USERNAME=
VOICE_SIP_PASSWORD=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
